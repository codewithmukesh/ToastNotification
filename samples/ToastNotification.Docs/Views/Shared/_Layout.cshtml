<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "ToastNotification") · AspNetCoreHero.ToastNotification</title>
    <meta name="description" content="Toast notifications for ASP.NET Core, straight from C#. Notyf and Toastify for MVC, Razor Pages and Minimal APIs." />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&family=Figtree:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="~/css/docs.css" asp-append-version="true" />
</head>
<body>
    <header class="nav">
        <div class="container nav-inner">
            <a class="logo" href="/">
                <span class="logo-mark">T</span>
                ToastNotification <small>v2</small>
            </a>
            <nav class="nav-links" id="nav-links" aria-label="Main">
                <a href="/#playground">Playground</a>
                <a href="/#compare">Compare</a>
                <a href="/#setup">Setup</a>
                <a href="/#docs">Docs</a>
                <a href="/checkout">Razor Pages demo</a>
                <a class="nav-extra" href="/#setup">Get started</a>
                <a class="nav-extra" href="https://github.com/codewithmukesh/ToastNotification">GitHub</a>
                <a class="nav-extra" href="https://www.nuget.org/packages/AspNetCoreHero.ToastNotification">NuGet</a>
            </nav>
            <div class="nav-actions">
                <a class="pill" href="https://github.com/codewithmukesh/ToastNotification">
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
                    GitHub
                </a>
                <a class="pill" href="https://www.nuget.org/packages/AspNetCoreHero.ToastNotification">NuGet</a>
                <button class="pill theme-toggle" type="button" aria-label="Switch between light and dark theme">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                </button>
                <a class="btn btn-primary btn-sm" href="/#setup">Get started</a>
                <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
            </div>
        </div>
    </header>

    @RenderBody()

    <footer class="container footer">
        <span>Built by <a href="https://codewithmukesh.com">Mukesh Murugan</a>. MIT licensed. Uses <a href="https://github.com/caroso1222/notyf">Notyf</a> by Carlos Roso and <a href="https://github.com/apvarun/toastify-js">Toastify</a> by Varun A P.</span>
        <nav>
            <a href="https://github.com/codewithmukesh/ToastNotification">GitHub</a>
            <a href="https://www.nuget.org/packages/AspNetCoreHero.ToastNotification">NuGet</a>
            <a href="https://codewithmukesh.com">codewithmukesh.com</a>
        </nav>
    </footer>

    @* This is all your layout needs. This sample renders both so the page can compare them. *@
    @await Component.InvokeAsync("Notyf")
    @await Component.InvokeAsync("Toastify")

    @* Only for the demos on this page - the library itself needs none of these. *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/4.0.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.2/highlight.min.js"></script>
    <script src="~/js/docs.js" asp-append-version="true"></script>
</body>
</html>
