@model ToastNotification.Notyf.Docs.CodeSample
<div class="code">
    <div class="code-head">
        <span>@Model.File</span>
        <button class="copy" type="button" data-copy="code-@Model.Id">copy</button>
    </div>
    <pre><code id="code-@Model.Id" class="language-@Model.Language">@Model.Code</code></pre>
</div>
